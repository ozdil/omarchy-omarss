#!/usr/bin/env bash
set -euo pipefail

# Prefer native Quickshell UI if available
if [[ "${1:-}" != "--cli" ]] && command -v quickshell >/dev/null 2>&1; then
    if quickshell ipc -p /usr/share/omarchy/shell call ozdil.omarss toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/omarss-engine"

if [[ ! -x "${BIN}" ]] && [[ -f "${DIR}/Cargo.toml" ]] && command -v cargo >/dev/null 2>&1; then
    echo "Building omarss-engine from source..."
    (cd "${DIR}" && cargo build --release --locked && cp "target/release/omarss-engine" "${BIN}" && chmod +x "${BIN}") || true
fi

if [[ -x "${BIN}" ]]; then
    clear
    exec "${BIN}" "$@"
else
    echo "Error: omarss-engine binary not found. Please run 'cargo build --release --locked' in ${DIR}"
    exit 1
fi

