#!/bin/bash -p
set -euo pipefail

# Fail-closed check: abort if any unexpected build-control or loader variables exist
for var in LD_PRELOAD LD_LIBRARY_PATH RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER RUSTFLAGS CARGO_ENCODED_RUSTFLAGS; do
    if [[ -n "${!var+x}" ]]; then
        echo "Error: Unexpected build or loader control variable detected: ${var}" >&2
        exit 1
    fi
done

if [[ -n "${CARGO_HOME:-}" ]] && [[ "${CARGO_HOME}" != "${HOME:-}/.cargo" ]]; then
    echo "Error: Non-standard CARGO_HOME detected: ${CARGO_HOME}" >&2
    exit 1
fi

# Re-exec through fixed trusted /bin/bash -p and /usr/bin/env -i with minimal explicit allowlist
if [[ "${OMARSS_ENV_SANITIZED:-}" != "1" ]]; then
    exec /usr/bin/env -i \
        OMARSS_ENV_SANITIZED=1 \
        PATH="/usr/bin:/bin:${HOME:-}/.cargo/bin" \
        HOME="${HOME:-/tmp}" \
        CARGO_HOME="${HOME:-}/.cargo" \
        USER="${USER:-}" \
        LANG="${LANG:-C.UTF-8}" \
        LC_ALL="${LC_ALL:-C.UTF-8}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        DISPLAY="${DISPLAY:-}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
        XDG_DATA_HOME="${XDG_DATA_HOME:-}" \
        XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-}" \
        XDG_CACHE_HOME="${XDG_CACHE_HOME:-}" \
        /bin/bash -p "$0" "$@"
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/omarss-engine"

# Resolve absolute trusted tool paths
CARGO_BIN=""
if [[ -x "/usr/bin/cargo" ]]; then
    CARGO_BIN="/usr/bin/cargo"
elif [[ -x "${HOME}/.cargo/bin/cargo" ]]; then
    CARGO_BIN="${HOME}/.cargo/bin/cargo"
fi

if [[ ! -x "${BIN}" ]] && [[ -f "${DIR}/Cargo.toml" ]] && [[ -n "${CARGO_BIN}" ]]; then
    (cd "${DIR}" && "${CARGO_BIN}" build --release --locked --quiet && /usr/bin/cp "target/release/omarss-engine" "${BIN}" && /usr/bin/chmod 0755 "${BIN}") >/dev/null 2>&1 || true
fi

if [[ -x "${BIN}" ]]; then
    exec "${BIN}" --status "$@"
else
    echo '{"text":"","tooltip":"OmaRSS (Engine unbuilt)","class":"normal","unread":0}'
fi

